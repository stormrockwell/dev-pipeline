		"@typescript-eslint/parser": "^8.72.1",
		"@wordpress/eslint-plugin": "^28.1.0",
		"@wordpress/stylelint-config": "^22.7.0",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"stylelint": "^14.16.1",
		"stylelint-config-recommended-scss": "^5.0.2",
		"stylelint-order": "^6.0.4",
