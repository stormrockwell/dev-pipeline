{
	"name": "{{slug}}",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "{{name}}",
	"engines": {
		"node": ">={{node}}"
	},
	"scripts": {
		"start": "node src/server.ts",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lint": "eslint . && stylelint \"**/*.{css,scss}\" --allow-empty-input",
		"format": "prettier --write .",
		"typecheck": "tsc",
		"prepare": "pipeline hooks install || echo 'warning: the pipeline CLI is missing, so the git hooks were not installed.'"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@digitalimpulse/coding-standards": "git+https://github.com/stormrockwell/coding-standards.git#{{standardsRef}}",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.65.0",
		"@types/node": "^24.19.2",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^9.39.5",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"stylelint": "^14.16.1",
		"stylelint-config-recommended-scss": "^5.0.2",
		"stylelint-order": "^6.0.4",
		"stylelint-semantic-groups": "^1.2.2",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	}
}
