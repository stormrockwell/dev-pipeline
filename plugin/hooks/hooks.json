{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.json\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pipeline run-log --hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^dev-pipeline:implementer$",
        "hooks": [
          {
            "type": "command",
            "command": "pipeline task-check --hook",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "^dev-pipeline:(spec-reviewer|standards-reviewer|simplifier|accessibility-reviewer|security-hunter|security-verifier)$",
        "hooks": [
          {
            "type": "command",
            "command": "pipeline review save --hook",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pipeline run-log --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pipeline run-log --hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pipeline run-log --hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pipeline run-log --hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pipeline run-log --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pipeline run-log --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
